# BPO Asset Management — local server settings.
# Copy this file to `.env` (git-ignored) and fill in your values.
# Real environment variables override anything in `.env`.

# PostgreSQL connection. URL-encode special characters in the password
# (@ -> %40, : -> %3A, # -> %23, / -> %2F, % -> %25, space -> %20).
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/bpoam

# Address you open in the browser. Must match exactly (used for the CSRF Origin check).
# Same-origin mode (npm run web:build, then server:dev):  http://127.0.0.1:3000
# Live-reload mode (npm run web:dev):                      http://localhost:5173
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Built browser app served by the API in same-origin mode. Comment out for live-reload mode.
WEB_ROOT=web/dist

# Optional
# APP_ENV=development
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# STORAGE_LOCAL_ROOT=./var/documents

# Production document storage (STORAGE_DRIVER=s3; required in production, see DECISIONS.md D47).
# Use a bucket-scoped, least-privilege credential (GetObject/PutObject/HeadObject/DeleteObject on
# this bucket's document prefix only) -- never an account-wide key.
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=bpoam-documents-prod
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ENDPOINT=              # omit for AWS; set for a non-AWS S3-compatible provider
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true  # most non-AWS S3-compatible providers need this
