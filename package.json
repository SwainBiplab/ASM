{
  "name": "bpo-asset-management",
  "productName": "BPO Asset Management",
  "version": "0.1.0",
  "description": "Standalone Windows asset management system for a single BPO organization",
  "private": true,
  "author": "BPO Asset Management Project",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:win": "npm run build && electron-builder --win",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify": "npm run typecheck && npm run test",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:server": "vitest run --project server",
    "test:prototype": "vitest run --project prototype",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "test:web-e2e": "npm run web:build && playwright test --config playwright.web.config.ts",
    "server:dev": "tsx watch --tsconfig tsconfig.server.json server/src/index.ts",
    "server:migrate": "tsx --tsconfig tsconfig.server.json server/src/cli/admin.ts migrate",
    "server:bootstrap": "tsx --tsconfig tsconfig.server.json server/src/cli/admin.ts bootstrap",
    "server:migrate-legacy": "tsx --tsconfig tsconfig.server.json server/src/cli/admin.ts migrate-legacy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "better-sqlite3": "13.0.3",
    "bwip-js": "4.11.4",
    "csv-parse": "7.0.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
